APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL adalah target produksi. Jalankan `docker compose up -d` untuk pgsql + redis lokal.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
# 5433 di host untuk menghindari bentrok dengan PostgreSQL native bila ada (container tetap 5432 internal).
DB_PORT=5433
DB_DATABASE=sttc_api
DB_USERNAME=sttc
DB_PASSWORD=secret

# Session & queue sengaja tetap di database (lihat epics/sprint-1-plan.md §5.3).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Redis dipakai untuk cache + throttle/lockout + (nanti) deny-list revocation.
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# phpredis tidak tersedia di semua lingkungan Windows -> default predis (pure PHP).
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=secret
REDIS_PORT=6379
REDIS_CACHE_DB=1
REDIS_THROTTLE_DB=2

# --- Laravel Passport (OAuth2 SSO) ---
PASSPORT_ACCESS_TOKEN_TTL=15
PASSPORT_REFRESH_TOKEN_TTL=20160

# Client OAuth internal (dipakai PassportClientSeeder di lokal/dev — JANGAN dipakai di prod).
# redirect URI boleh multi-value dipisah koma.
SIAKAD_CLIENT_SECRET=sttc-siakad-local-dev-secret
SIAKAD_REDIRECT_URI=http://localhost:8001/sso/callback
WEBSITE_CLIENT_SECRET=sttc-website-local-dev-secret
WEBSITE_REDIRECT_URI=http://localhost:8002/auth/callback

# --- Login throttle / lockout (config/security.php, epics/sprint-1-plan.md §5.2) ---
LOGIN_THROTTLE_STORE=throttle
LOGIN_THROTTLE_FAIL_OPEN=true
LOGIN_L1_MAX=5
LOGIN_L2_MAX=20
LOGIN_L3_MAX=10
LOGIN_2FA_MAX=5

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
